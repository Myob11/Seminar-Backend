        {
            "name": "Store key envelope",
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "var recipientId = pm.environment.get('recipientId');",
                    "if (!recipientId) {",
                    "    throw new Error('Set recipientId to the user whose RSA public key wrapped the envelope.');",
                    "}"
                  ]
                }
              }
            ],
            "request": {
              "auth": {
                "type": "bearer",
                "bearer": [
                  {
                    "key": "token",
                    "value": "{{accessToken}}",
                    "type": "string"
                  }
                ]
              },
              "method": "PUT",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"key_version\": 1,\n  \"encrypted_conversation_key\": \"{{keyEnvelopeCiphertext}}\"\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/key-envelopes/{{recipientId}}",
                "host": [
