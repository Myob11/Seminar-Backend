                ],
                "path": [
                  "api",
                  "conversations",
                  "{{conversationId}}",
                  "key-envelopes",
                  "{{recipientId}}"
                ]
              },
              "description": "Store an RSA-OAEP wrapped conversation key for an active recipient."
            },
            "response": []
        },
